generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

model User {
  id                              String                     @id @default(cuid())
  email                           String                     @unique
  fullName                        String
  password                        String?
  googleId                        String?                    @unique
  authProvider                    AuthProvider               @default(LOCAL)
  role                            Role                       @default(USER)
  brandId                         String?                    @unique
  brandInviteTokenHash            String?
  brandInviteTokenExpiresAt       DateTime?
  brandInviteAcceptedAt           DateTime?
  codRefusalCount                 Int                        @default(0)
  lastCodRefusalAt                DateTime?
  codReviewFlag                   Boolean                    @default(false)
  codReviewStatus                 CodReviewStatus            @default(CLEAR)
  codReviewNote                   String?
  codBlockedAt                    DateTime?
  codPrepaymentRequired           Boolean                    @default(false)
  createdAt                       DateTime                   @default(now())
  updatedAt                       DateTime                   @updatedAt
  emailVerificationTokenExpiresAt DateTime?
  emailVerificationTokenHash      String?
  emailVerifiedAt                 DateTime?
  passwordResetTokenExpiresAt     DateTime?
  passwordResetTokenHash          String?
  brandMemberships                BrandMember[]
  brandReviewReplies              BrandReviewReply[]
  cart                            Cart?
  notifications                   Notification[]
  notificationPreference          NotificationPreference?
  orders                          Order[]
  returnRequests                  ReturnRequest[]
  productTemplates                ProductContentTemplate[]   @relation("TemplateCreatedBy")
  reviewModerations               Review[]                   @relation("ReviewModeratedBy")
  reviews                         Review[]
  reviewVotes                     ReviewHelpfulnessVote[]
  reviewModerationLogs            ReviewModerationLog[]
  reviewReports                   ReviewReport[]             @relation("ReviewReportsByUser")
  resolvedReviewReports           ReviewReport[]             @relation("ReviewReportsResolvedBy")
  recommendationClicks            RecommendationClick[]
  recommendationImpressions       RecommendationImpression[]
  recommendationProfile           UserRecommendationProfile?
  sessions                        Session[]
  brand                           Brand?                     @relation("BrandOwnership", fields: [brandId], references: [id])
  activities                      UserActivity[]
  addresses                       UserAddress[]
  deviceTokens                    UserDeviceToken[]
  paymentMethods                  UserPaymentMethod[]
  wallet                          UserWallet?
  walletTransactions              WalletTransaction[]
  paymentSessions                 PaymentSession[]
  wishlistItems                   WishlistItem[]
  productApprovalsReviewed        ProductApproval[]
}

model UserPaymentMethod {
  id           String          @id @default(cuid())
  userId       String
  type         UserPaymentType
  label        String
  last4        String
  expiresMonth Int?
  expiresYear  Int?
  isDefault    Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model UserWallet {
  id                  String              @id @default(cuid())
  userId              String              @unique
  availableBalancePkr Int                 @default(0)
  totalCreditedPkr    Int                 @default(0)
  totalDebitedPkr     Int                 @default(0)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions        WalletTransaction[]
}

model WalletTransaction {
  id                   String                  @id @default(cuid())
  walletId             String
  userId               String
  type                 WalletTransactionType
  sourceType           WalletTransactionSource
  amountPkr            Int
  balanceAfterPkr      Int
  note                 String?
  orderId              String?
  refundRequestId      String?                 @unique
  paymentTransactionId String?
  createdAt            DateTime                @default(now())
  wallet               UserWallet              @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user                 User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  order                Order?                  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  refundRequest        RefundRequest?          @relation(fields: [refundRequestId], references: [id], onDelete: SetNull)

  @@index([walletId, createdAt])
  @@index([userId, createdAt])
  @@index([orderId, createdAt])
}

model UserAddress {
  id           String   @id @default(cuid())
  userId       String
  label        String
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String?
  country      String   @default("Pakistan")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
}

model NotificationPreference {
  id             String   @id @default(cuid())
  userId         String   @unique
  orderUpdates   Boolean  @default(true)
  promoEmails    Boolean  @default(false)
  securityAlerts Boolean  @default(true)
  wishlistAlerts Boolean  @default(true)
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserDeviceToken {
  id         String    @id @default(cuid())
  userId     String
  token      String    @unique
  platform   String    @default("WEB")
  userAgent  String?
  disabledAt DateTime?
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, disabledAt])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id            String   @id @default(cuid())
  cartId        String
  productId     String
  quantity      Int      @default(1)
  selectedColor String?
  selectedSize  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  cart          Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, selectedColor, selectedSize])
  @@index([productId])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenId   String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Brand {
  id                   String                   @id @default(cuid())
  name                 String                   @unique
  slug                 String                   @unique
  logoUrl              String?
  description          String?
  verified             Boolean                  @default(true)
  commissionRate       Float                    @default(12)
  apiEnabled           Boolean                  @default(false)
  contactEmail         String?
  whatsappNumber       String?
  returnWindowDays     Int                      @default(7)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  members              BrandMember[]
  reviewReplies        BrandReviewReply[]
  notifications        Notification[]
  orderItems           OrderItem[]
  products             Product[]
  importJobs           ImportJob[]
  categories           Category[]
  tags                 ProductTag[]
  productTemplates     ProductContentTemplate[]
  reviews              Review[]
  subOrders            SubOrder[]
  cancellationRequests CancellationRequest[]
  owner                User?                    @relation("BrandOwnership")
}

model BrandMember {
  id                String   @id @default(cuid())
  userId            String
  brandId           String
  canManageProducts Boolean  @default(true)
  createdAt         DateTime @default(now())
  brand             Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, brandId])
  @@index([brandId])
}

model Product {
  id                          String                  @id @default(cuid())
  brandId                     String
  approvalStatus              ProductApprovalStatus   @default(APPROVED)
  approvalReviewedAt          DateTime?
  approvalReviewedById        String?
  searchDocument              String                  @default("")
  name                        String
  slug                        String                  @unique
  shortDescription            String?
  description                 String
  gender                      ProductGender
  productType                 ProductType
  department                  ProductDepartment
  category                    ProductCategory
  subcategory                 ProductSubcategory?
  brandCategoryRaw            String?
  brandSubcategoryRaw         String?
  colors                      String[]                @default([])
  primaryColor                String?
  colorCode                   String?
  sizes                       String[]
  sizeType                    String?
  material                    String?
  fit                         String?
  season                      String?
  collection                  String?
  tags                        String[]                @default([])
  searchKeywords              String[]                @default([])
  recommendedKeywords         String[]                @default([])
  searchBoost                 Float                   @default(1.0)
  availabilityStatus          ProductAvailability     @default(IN_STOCK)
  isFeatured                  Boolean                 @default(false)
  isRecommended               Boolean                 @default(false)
  isTrending                  Boolean                 @default(false)
  isNewArrival                Boolean                 @default(false)
  isBestSeller                Boolean                 @default(false)
  classificationConfidence    Float?
  productUrl                  String?
  visibility                  String                  @default("visible")
  source                      String                  @default("manual")
  actualPrice                 Float
  salePrice                   Float?
  discountPercentage          Float?
  discountType                String?
  discountValue               Float?
  isOnSale                    Boolean                 @default(false)
  pricePkr                    Int
  currency                    String                  @default("PKR")
  label                       String?
  saleStartDate               DateTime?
  saleEndDate                 DateTime?
  imageUrl                    String
  sizeGuideTemplateId         String?
  sizeGuide                   Json?
  deliveriesReturnsTemplateId String?
  deliveriesReturns           Json?
  shippingDeliveryTemplateId  String?
  shippingDelivery            Json?
  fabricCareTemplateId        String?
  fabricCare                  Json?
  stock                       Int                     @default(0)
  isActive                    Boolean                 @default(true)
  externalProductId           String?
  externalSource              String?
  importHash                  String?
  pageContext                 Json?
  metadata                    Json?
  deletedAt                   DateTime?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
  createdById                 String?
  updatedById                 String?
  cartItems                   CartItem[]
  orderItems                  OrderItem[]
  brand                       Brand                   @relation(fields: [brandId], references: [id])
  reviewAggregate             ProductReviewAggregate?
  reviews                     Review[]
  activities                  UserActivity[]
  recommendationClicks        RecommendationClick[]
  wishlistItems               WishlistItem[]
  variants                    ProductVariant[]
  images                      ProductImage[]
  detail                      ProductDetail?
  shipping                    ProductShipping?
  seo                         ProductSEO?
  importMeta                  ProductImportMeta?
  attributes                  ProductAttribute[]
  inventoryRecords            Inventory[]
  approvals                   ProductApproval[]
  importLogs                  ImportLog[]
  importRawData               RawImportData[]
  productTags                 ProductTagOnProduct[]

  @@unique([brandId, externalSource, externalProductId])
  @@index([gender, department, category])
  @@index([brandId, category, subcategory])
  @@index([category, subcategory])
  @@index([department, category])
  @@index([productType])
  @@index([pricePkr])
  @@index([brandId, externalProductId])
  @@index([brandId, approvalStatus, deletedAt])
  @@index([classificationConfidence])
  @@index([availabilityStatus, isActive])
}

model Category {
  id            String        @id @default(cuid())
  brandId       String?
  name          String
  slug          String
  description   String?
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  brand         Brand?        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  subCategories SubCategory[]

  @@unique([brandId, slug])
  @@index([name])
}

model SubCategory {
  id         String    @id @default(cuid())
  categoryId String
  name       String
  slug       String
  metadata   Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, slug])
  @@index([name])
}

model ProductVariant {
  id                String         @id @default(cuid())
  productId         String
  externalVariantId String?
  sku               String
  barcode           String?
  color             String?
  colorHex          String?
  size              String?
  fit               String?
  season            String?
  style             String?
  pricePkr          Int
  salePricePkr      Int?
  compareAtPricePkr Int?
  stockStatus       String         @default("in_stock")
  lowStockThreshold Int?
  weight            Float?
  isActive          Boolean        @default(true)
  metadata          Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?
  product           Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory         Inventory?
  images            ProductImage[]

  @@unique([sku])
  @@index([productId, isActive])
  @@index([productId, color, size])
  @@index([barcode])
}

model ProductImage {
  id         String          @id @default(cuid())
  productId  String
  variantId  String?
  sourceUrl  String
  storageKey String?
  url        String
  cdnUrl     String?
  altText    String?
  imageType  String          @default("gallery")
  width      Int?
  height     Int?
  isPrimary  Boolean         @default(false)
  sortOrder  Int             @default(0)
  dedupeHash String?
  metadata   Json?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deletedAt  DateTime?
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@index([productId, imageType])
  @@index([variantId])
  @@index([dedupeHash])
}

model ProductDetail {
  productId            String   @id
  fabricComposition    String?
  careGuide            String?
  fitDetails           String?
  modelDetails         String?
  sizeGuideText        String?
  sizeGuideImageUrl    String?
  shippingDelivery     String?
  returnExchangePolicy String?
  disclaimer           String?
  materialDetails      String?
  origin               String?
  packageIncludes      String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  product              Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductShipping {
  productId                String   @id
  estimatedDeliveryMinDays Int?
  estimatedDeliveryMaxDays Int?
  deliveryText             String?
  shippingFee              Int?
  freeShippingAvailable    Boolean?
  codAvailable             Boolean?
  returnAvailable          Boolean?
  exchangeAvailable        Boolean?
  returnWindowDays         Int?
  exchangeWindowDays       Int?
  nonReturnableReason      String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  product                  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductSEO {
  productId       String   @id
  metaTitle       String?
  metaDescription String?
  metaKeywords    String[] @default([])
  canonicalUrl    String?
  ogImageUrl      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductImportMeta {
  productId        String    @id
  importBatchId    String?
  sourceFormat     String?
  sourceBrandName  String?
  rawProductData   Json?
  mappingStatus    String?
  validationErrors Json?
  lastSyncedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([importBatchId])
  @@index([sourceFormat, mappingStatus])
}

model ProductAttribute {
  id        String   @id @default(cuid())
  productId String
  key       String
  value     String
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, key])
}

model ProductTag {
  id        String                @id @default(cuid())
  brandId   String?
  name      String
  slug      String
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  brand     Brand?                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  products  ProductTagOnProduct[]

  @@unique([brandId, slug])
}

model ProductTagOnProduct {
  productId String
  tagId     String
  createdAt DateTime   @default(now())
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       ProductTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

model ImportJob {
  id                String            @id @default(cuid())
  brandId           String
  sourceType        ImportSourceType
  sourceLabel       String?
  sourceLocation    String?
  status            ImportJobStatus   @default(PENDING)
  totalRecords      Int               @default(0)
  processedRecords  Int               @default(0)
  successfulRecords Int               @default(0)
  failedRecords     Int               @default(0)
  startedAt         DateTime?
  completedAt       DateTime?
  metadata          Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  brand             Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  logs              ImportLog[]
  rawData           RawImportData[]
  approvals         ProductApproval[]

  @@index([brandId, status, createdAt])
}

model ImportLog {
  id          String         @id @default(cuid())
  importJobId String
  productId   String?
  level       ImportLogLevel @default(INFO)
  code        String?
  message     String
  details     Json?
  createdAt   DateTime       @default(now())
  importJob   ImportJob      @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  product     Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([importJobId, level, createdAt])
}

model RawImportData {
  id             String    @id @default(cuid())
  importJobId    String
  productId      String?
  externalId     String?
  payload        Json
  normalizedHash String?
  createdAt      DateTime  @default(now())
  importJob      ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  product        Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([importJobId, externalId])
  @@index([normalizedHash])
}

model ProductApproval {
  id              String               @id @default(cuid())
  productId       String
  importJobId     String?
  status          ProductApprovalState @default(PENDING)
  reviewerId      String?
  rejectionReason String?
  reviewNotes     String?
  reviewedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  product         Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  importJob       ImportJob?           @relation(fields: [importJobId], references: [id], onDelete: SetNull)
  reviewer        User?                @relation(fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([importJobId, status])
}

model Inventory {
  id           String             @id @default(cuid())
  productId    String
  variantId    String?            @unique
  sku          String
  quantity     Int                @default(0)
  reserved     Int                @default(0)
  available    Int                @default(0)
  lowStockAt   Int                @default(5)
  syncState    InventorySyncState @default(IDLE)
  lastSyncedAt DateTime?
  metadata     Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  product      Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([productId, sku])
  @@index([syncState, updatedAt])
}

model ProductContentTemplate {
  id          String              @id @default(cuid())
  type        ProductTemplateType
  name        String
  content     Json
  brandId     String?
  createdById String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  brand       Brand?              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdBy   User                @relation("TemplateCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([name, type, brandId])
  @@index([type])
  @@index([brandId, type])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Order {
  id                   String                @id @default(cuid())
  userId               String
  status               OrderStatus           @default(PENDING)
  paymentMethod        PaymentMethod
  paymentStatus        PaymentStatus         @default(PENDING)
  totalPkr             Int
  deliveryAddress      String
  trackingId           String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  notifications        Notification[]
  user                 User                  @relation(fields: [userId], references: [id])
  items                OrderItem[]
  statusLogs           OrderStatusLog[]
  paymentTransactions  PaymentTransaction[]
  subOrders            SubOrder[]
  cancellationRequests CancellationRequest[]
  returnRequests       ReturnRequest[]
  refundRequests       RefundRequest[]
  walletTransactions   WalletTransaction[]
  paymentSessions      PaymentSession[]

  @@index([userId, status])
}

model PaymentTransaction {
  id                   String        @id @default(cuid())
  orderId              String
  gateway              PaymentMethod
  gatewayTransactionId String        @unique
  status               String
  amountPkr            Int
  rawPayload           Json?
  createdAt            DateTime      @default(now())
  order                Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model PaymentSession {
  id                   String               @id @default(cuid())
  orderId              String
  userId               String
  paymentMethod        PaymentMethod
  gateway              String               @default("DEMO_GATEWAY")
  gatewayTransactionId String               @unique
  status               PaymentSessionStatus @default(PENDING)
  redirectUrl          String
  expiresAt            DateTime
  completedAt          DateTime?
  failedAt             DateTime?
  lastErrorReason      String?
  attemptNumber        Int                  @default(1)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  order                Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

model OrderItem {
  id            String              @id @default(cuid())
  orderId       String
  subOrderId    String?
  productId     String
  brandId       String
  quantity      Int
  unitPricePkr  Int
  selectedColor String?
  selectedSize  String?
  brand         Brand               @relation(fields: [brandId], references: [id])
  order         Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product             @relation(fields: [productId], references: [id])
  subOrder      SubOrder?           @relation(fields: [subOrderId], references: [id])
  review        Review?
  refundItems   RefundRequestItem[]

  @@index([brandId, orderId])
  @@index([subOrderId])
}

model SubOrder {
  id                     String                @id @default(cuid())
  orderId                String
  brandId                String
  status                 OrderStatus           @default(PENDING)
  subtotalPkr            Int
  trackingId             String?
  courierName            String?
  estimatedDelivery      DateTime?
  deliveryAttempts       Int                   @default(0)
  failureReason          String?
  failureReasonMessage   String?
  deliveryFailedAt       DateTime?
  brandReminderSentAt    DateTime?
  lastAttemptAt          DateTime?
  nextAttemptDate        DateTime?
  finalDeliveryFailureAt DateTime?
  refundProcessedAt      DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  items                  OrderItem[]
  brand                  Brand                 @relation(fields: [brandId], references: [id], onDelete: Cascade)
  order                  Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  statusLogs             SubOrderStatusLog[]
  statusHistory          StatusHistory[]
  cancellationRequests   CancellationRequest[]
  refundRequests         RefundRequest[]
  returnRequests         ReturnRequest[]

  @@unique([orderId, brandId])
  @@index([brandId, status])
  @@index([orderId, createdAt])
}

model CancellationRequest {
  id                String                     @id @default(cuid())
  orderId           String
  subOrderId        String
  brandId           String
  orderItemIds      String[]                   @default([])
  requestedByRole   CancellationRequestedBy
  requestedById     String?
  reasonCode        CancellationReasonCode
  reasonText        String?
  status            CancellationRequestStatus  @default(REQUESTED)
  brandResponseCode CancellationBrandResponse?
  brandResponseNote String?
  evidenceUrl       String?
  trackingEvidence  String?
  respondedAt       DateTime?
  decidedById       String?
  decidedAt         DateTime?
  decisionNote      String?
  expiresAt         DateTime
  autoApproveAt     DateTime
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

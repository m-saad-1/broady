generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

model User {
  id                              String                   @id @default(cuid())
  email                           String                   @unique
  fullName                        String
  password                        String?
  googleId                        String?                  @unique
  authProvider                    AuthProvider             @default(LOCAL)
  role                            Role                     @default(USER)
  brandId                         String?                  @unique
  brandInviteTokenHash            String?
  brandInviteTokenExpiresAt       DateTime?
  brandInviteAcceptedAt           DateTime?
  createdAt                       DateTime                 @default(now())
  updatedAt                       DateTime                 @updatedAt
  emailVerificationTokenExpiresAt DateTime?
  emailVerificationTokenHash      String?
  emailVerifiedAt                 DateTime?
  passwordResetTokenExpiresAt     DateTime?
  passwordResetTokenHash          String?
  brandMemberships                BrandMember[]
  brandReviewReplies              BrandReviewReply[]
  cart                            Cart?
  notifications                   Notification[]
  notificationPreference          NotificationPreference?
  orders                          Order[]
  productTemplates                ProductContentTemplate[] @relation("TemplateCreatedBy")
  reviewModerations               Review[]                 @relation("ReviewModeratedBy")
  reviews                         Review[]
  reviewVotes                     ReviewHelpfulnessVote[]
  reviewModerationLogs            ReviewModerationLog[]
  reviewReports                   ReviewReport[]           @relation("ReviewReportsByUser")
  resolvedReviewReports           ReviewReport[]           @relation("ReviewReportsResolvedBy")
  sessions                        Session[]
  brand                           Brand?                   @relation("BrandOwnership", fields: [brandId], references: [id])
  activities                      UserActivity[]
  addresses                       UserAddress[]
  deviceTokens                    UserDeviceToken[]
  paymentMethods                  UserPaymentMethod[]
  wishlistItems                   WishlistItem[]
}

model UserPaymentMethod {
  id           String          @id @default(cuid())
  userId       String
  type         UserPaymentType
  label        String
  last4        String
  expiresMonth Int?
  expiresYear  Int?
  isDefault    Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model UserAddress {
  id           String   @id @default(cuid())
  userId       String
  label        String
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String?
  country      String   @default("Pakistan")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
}

model NotificationPreference {
  id             String   @id @default(cuid())
  userId         String   @unique
  orderUpdates   Boolean  @default(true)
  promoEmails    Boolean  @default(false)
  securityAlerts Boolean  @default(true)
  wishlistAlerts Boolean  @default(true)
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserDeviceToken {
  id         String    @id @default(cuid())
  userId     String
  token      String    @unique
  platform   String    @default("WEB")
  userAgent  String?
  disabledAt DateTime?
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, disabledAt])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id            String   @id @default(cuid())
  cartId        String
  productId     String
  quantity      Int      @default(1)
  selectedColor String?
  selectedSize  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  cart          Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, selectedColor, selectedSize])
  @@index([productId])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenId   String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Brand {
  id               String                   @id @default(cuid())
  name             String                   @unique
  slug             String                   @unique
  logoUrl          String?
  description      String?
  verified         Boolean                  @default(true)
  commissionRate   Float                    @default(12)
  apiEnabled       Boolean                  @default(false)
  contactEmail     String?
  whatsappNumber   String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  members          BrandMember[]
  reviewReplies    BrandReviewReply[]
  notifications    Notification[]
  orderItems       OrderItem[]
  products         Product[]
  productTemplates ProductContentTemplate[]
  reviews          Review[]
  subOrders        SubOrder[]
  owner            User?                    @relation("BrandOwnership")
}

model BrandMember {
  id                String   @id @default(cuid())
  userId            String
  brandId           String
  canManageProducts Boolean  @default(true)
  createdAt         DateTime @default(now())
  brand             Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, brandId])
  @@index([brandId])
}

model Product {
  id                          String                  @id @default(cuid())
  brandId                     String
  approvalStatus              ProductApprovalStatus   @default(APPROVED)
  approvalReviewedAt          DateTime?
  approvalReviewedById        String?
  searchDocument              String                  @default("")
  name                        String
  slug                        String                  @unique
  description                 String
  gender                      String                  @default("WOMEN")
  color                       String                  @default("default")
  type                        String                  @default("Top")
  actualPrice                 Float
  salePrice                   Float?
  discountPercentage          Float?
  pricePkr                    Int
  topCategory                 String
  subCategory                 String
  sizes                       String[]
  tags                        String[]                @default([])
  imageUrl                    String
  sizeGuideTemplateId         String?
  sizeGuide                   Json?
  deliveriesReturnsTemplateId String?
  deliveriesReturns           Json?
  shippingDeliveryTemplateId  String?
  shippingDelivery            Json?
  fabricCareTemplateId        String?
  fabricCare                  Json?
  stock                       Int                     @default(0)
  isActive                    Boolean                 @default(true)
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
  cartItems                   CartItem[]
  orderItems                  OrderItem[]
  brand                       Brand                   @relation(fields: [brandId], references: [id])
  reviewAggregate             ProductReviewAggregate?
  reviews                     Review[]
  activities                  UserActivity[]
  wishlistItems               WishlistItem[]

  @@index([brandId, topCategory, subCategory])
  @@index([topCategory, subCategory])
  @@index([pricePkr])
}

model ProductContentTemplate {
  id          String              @id @default(cuid())
  type        ProductTemplateType
  name        String
  content     Json
  brandId     String?
  createdById String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  brand       Brand?              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdBy   User                @relation("TemplateCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([name, type, brandId])
  @@index([type])
  @@index([brandId, type])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Order {
  id                  String               @id @default(cuid())
  userId              String
  status              OrderStatus          @default(PENDING)
  paymentMethod       PaymentMethod
  paymentStatus       PaymentStatus        @default(PENDING)
  totalPkr            Int
  deliveryAddress     String
  trackingId          String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  notifications       Notification[]
  user                User                 @relation(fields: [userId], references: [id])
  items               OrderItem[]
  statusLogs          OrderStatusLog[]
  paymentTransactions PaymentTransaction[]
  subOrders           SubOrder[]

  @@index([userId, status])
}

model PaymentTransaction {
  id                   String        @id @default(cuid())
  orderId              String
  gateway              PaymentMethod
  gatewayTransactionId String        @unique
  status               String
  amountPkr            Int
  rawPayload           Json?
  createdAt            DateTime      @default(now())
  order                Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model OrderItem {
  id            String    @id @default(cuid())
  orderId       String
  subOrderId    String?
  productId     String
  brandId       String
  quantity      Int
  unitPricePkr  Int
  selectedColor String?
  selectedSize  String?
  brand         Brand     @relation(fields: [brandId], references: [id])
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product   @relation(fields: [productId], references: [id])
  subOrder      SubOrder? @relation(fields: [subOrderId], references: [id])
  review        Review?

  @@index([brandId, orderId])
  @@index([subOrderId])
}

model SubOrder {
  id                     String              @id @default(cuid())
  orderId                String
  brandId                String
  status                 OrderStatus         @default(PENDING)
  subtotalPkr            Int
  trackingId             String?
  deliveryAttempts       Int                 @default(0)
  failureReason          String?
  failureReasonMessage   String?
  deliveryFailedAt       DateTime?
  brandReminderSentAt    DateTime?
  lastAttemptAt          DateTime?
  nextAttemptDate        DateTime?
  finalDeliveryFailureAt DateTime?
  refundProcessedAt      DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  items                  OrderItem[]
  brand                  Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  order                  Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  statusLogs             SubOrderStatusLog[]

  @@unique([orderId, brandId])
  @@index([brandId, status])
  @@index([orderId, createdAt])
}

model Review {
  id                 String                  @id @default(cuid())
  productId          String
  userId             String
  brandId            String
  orderItemId        String                  @unique
  rating             Int
  title              String?                 @db.VarChar(120)
  content            String
  status             ReviewStatus            @default(VISIBLE)
  isVerifiedPurchase Boolean                 @default(true)
  moderatedById      String?
  moderationReason   String?
  moderatedAt        DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  brandReply         BrandReviewReply?
  brand              Brand                   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  moderatedBy        User?                   @relation("ReviewModeratedBy", fields: [moderatedById], references: [id])
  orderItem          OrderItem               @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product            Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  helpfulnessVotes   ReviewHelpfulnessVote[]
  images             ReviewImage[]
  moderationLogs     ReviewModerationLog[]
  reports            ReviewReport[]

  @@index([productId, status, createdAt])
  @@index([userId, createdAt])
  @@index([brandId, status, createdAt])
}

model ReviewImage {
  id        String   @id @default(cuid())
  reviewId  String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, sortOrder])
}

model ReviewHelpfulnessVote {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  isHelpful Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId])
}

model ReviewReport {
  id               String             @id @default(cuid())
  reviewId         String
  reportedByUserId String
  reason           ReviewReportReason
  description      String?
  status           ReviewReportStatus @default(OPEN)
  resolutionNote   String?
  resolvedById     String?
  resolvedAt       DateTime?
  createdAt        DateTime           @default(now())
  reportedByUser   User               @relation("ReviewReportsByUser", fields: [reportedByUserId], references: [id], onDelete: Cascade)
  resolvedBy       User?              @relation("ReviewReportsResolvedBy", fields: [resolvedById], references: [id])
  review           Review             @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, status, createdAt])
  @@index([reportedByUserId, createdAt])
}

model ReviewModerationLog {
  id          String                 @id @default(cuid())
  reviewId    String
  action      ReviewModerationAction
  moderatorId String?
  reason      String?
  createdAt   DateTime               @default(now())
  moderator   User?                  @relation(fields: [moderatorId], references: [id])
  review      Review                 @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, createdAt])
}

model BrandReviewReply {
  id        String   @id @default(cuid())
  reviewId  String   @unique
  brandId   String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([brandId, createdAt])
}

model ProductReviewAggregate {
  id            String   @id @default(cuid())
  productId     String   @unique
  averageRating Float    @default(0)
  totalReviews  Int      @default(0)
  rating1       Int      @default(0)
  rating2       Int      @default(0)
  rating3       Int      @default(0)
  rating4       Int      @default(0)
  rating5       Int      @default(0)
  updatedAt     DateTime @updatedAt
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model OrderStatusLog {
  id          String               @id @default(cuid())
  orderId     String
  status      OrderStatus
  updatedBy   OrderStatusUpdatedBy
  updatedById String?
  note        String?
  createdAt   DateTime             @default(now())
  order       Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model SubOrderStatusLog {
  id          String               @id @default(cuid())
  subOrderId  String
  status      OrderStatus
  updatedBy   OrderStatusUpdatedBy
  updatedById String?
  note        String?
  createdAt   DateTime             @default(now())
  subOrder    SubOrder             @relation(fields: [subOrderId], references: [id], onDelete: Cascade)

  @@index([subOrderId, createdAt])
}

model Notification {
  id               String                     @id @default(cuid())
  userId           String
  brandId          String?
  orderId          String?
  type             NotificationType
  title            String
  message          String
  readAt           DateTime?
  channel          NotificationChannel        @default(DASHBOARD)
  deliveryStatus   NotificationDeliveryStatus @default(QUEUED)
  deliveryAttempts Int                        @default(0)
  failedReason     String?
  nextAttemptAt    DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @default(now()) @updatedAt
  brand            Brand?                     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  order            Order?                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user             User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelLogs      NotificationChannelLog[]

  @@index([userId, createdAt])
  @@index([brandId, createdAt])
}

model NotificationChannelLog {
  id             String                     @id @default(cuid())
  notificationId String
  channel        NotificationChannel
  status         NotificationDeliveryStatus
  recipient      String
  error          String?
  createdAt      DateTime                   @default(now())
  notification   Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
}

model UserActivity {
  id          String                @id @default(cuid())
  userId      String
  productId   String?
  eventType   UserActivityEventType
  searchQuery String?
  topCategory String?
  subCategory String?
  weight      Float                 @default(0)
  metadata    Json?
  createdAt   DateTime              @default(now())
  product     Product?              @relation(fields: [productId], references: [id])
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, eventType, createdAt])
  @@index([productId, eventType, createdAt])
}

enum Role {
  USER
  ADMIN
  BRAND
  BRAND_ADMIN
  BRAND_STAFF
  SUPER_ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  PARTIALLY_SHIPPED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERY_FAILED
  ADDRESS_CORRECTION_REQUIRED
  READY_FOR_REDELIVERY
  DELIVERED
  RETURNED
  CANCELED
}

enum PaymentStatus {
  PENDING
  HELD
  BRAND_COLLECTS_COD
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  COD
  JAZZCASH
  EASYPAISA
}

enum UserPaymentType {
  CARD
  JAZZCASH
  EASYPAISA
  BANK
}

enum OrderStatusUpdatedBy {
  SYSTEM
  BRAND
  ADMIN
}

enum DeliveryFailureReason {
  CUSTOMER_NOT_AVAILABLE
  INCORRECT_ADDRESS
  PHONE_UNREACHABLE
  REFUSED_DELIVERY
  AREA_NOT_SERVICEABLE
  OTHER
}

enum NotificationType {
  ORDER_PLACED
  PAYMENT_SUCCESS
  ORDER_STATUS_UPDATED
  SUBORDER_CONFIRMED
  SUBORDER_SHIPPED
  SUBORDER_DELIVERED
  SUBORDER_CANCELLED
  BRAND_ORDER_ASSIGNED
  PRODUCT_APPROVED
  PRODUCT_REJECTED
  PRODUCT_REVIEW_SUBMITTED
  PRODUCT_REVIEW_REPORTED
  PRODUCT_REVIEW_MODERATED
  PRODUCT_REVIEW_REPLIED
  ACCOUNT_VERIFICATION
  PASSWORD_RESET
}

enum ReviewStatus {
  VISIBLE
  HIDDEN
  FLAGGED
  REMOVED
}

enum ReviewReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ReviewReportReason {
  SPAM
  INAPPROPRIATE
  OFFENSIVE_LANGUAGE
  FAKE_REVIEW
  OTHER
}

enum ReviewModerationAction {
  HIDE
  UNHIDE
  FLAG
  REMOVE
}

enum NotificationChannel {
  DASHBOARD
  EMAIL
  PUSH
  WHATSAPP
}

enum NotificationDeliveryStatus {
  SENT
  QUEUED
  FAILED
  READ
}

enum ProductApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum ProductTemplateType {
  SIZE_GUIDE
  DELIVERIES_RETURNS
  SHIPPING_DELIVERY
  FABRIC_CARE
}

enum UserActivityEventType {
  PRODUCT_VIEW
  PRODUCT_ADDED_TO_CART
  PRODUCT_PURCHASED
  SEARCH_QUERY
  CATEGORY_BROWSE
  WISHLIST_ADDED
}

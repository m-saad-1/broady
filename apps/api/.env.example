PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/broady
DATABASE_DIRECT_URL=postgresql://postgres:postgres@localhost:5432/broady
JWT_SECRET=replace_with_long_secret
WEB_APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
CLOUDINARY_URL=
AWS_S3_BUCKET=
CLOUDFLARE_CDN_URL=
EMAIL_FROM_NAME=Broady
EMAIL_FROM_ADDRESS=msaad23305@gmail.com
EMAIL_PROVIDER=ses
# Amazon SES SMTP settings. Use the region that owns your SES identity.
AWS_REGION=ap-south-1
SES_REGION=ap-south-1
SES_SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_SECURE=false
SES_SMTP_USER=your_smtp_username
SES_SMTP_PASS=your_smtp_password
WHATSAPP_WEBHOOK_URL=

REDIS_URL=redis://127.0.0.1:6379

# Meilisearch — never commit real values. For Cloud, use Settings "Database URL" as MEILISEARCH_URL or MEILISEARCH_DATABASE_URL.
MEILISEARCH_URL=http://127.0.0.1:7700
MEILISEARCH_DATABASE_URL=
MEILI_MASTER_KEY=replace_with_meilisearch_master_key
MEILISEARCH_ADMIN_API_KEY=replace_with_default_admin_api_key
MEILISEARCH_SEARCH_API_KEY=replace_with_default_search_api_key
MEILISEARCH_CHAT_API_KEY=replace_with_default_chat_api_key
MEILISEARCH_API_KEY=replace_with_admin_or_search_key_for_legacy_reads
NOTIFICATION_QUEUE_ADAPTER=redis
NOTIFICATION_REDIS_QUEUE_NAME=broady-notifications
NOTIFICATION_REDIS_PREFIX=broady
NOTIFICATION_WORKER_POLL_MS=250
NOTIFICATION_WORKER_CONCURRENCY=4
NOTIFICATION_WORKER_LOCK_TIMEOUT_MS=30000
NOTIFICATION_WORKER_MAX_ATTEMPTS=3
NOTIFICATION_WORKER_SHUTDOWN_WAIT_MS=5000
NOTIFICATION_WORKER_EMBEDDED=true
NOTIFICATION_WORKER_HEALTH_PORT=0
